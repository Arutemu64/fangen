# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.toml]
indent_size = 4

[*.md]
# Trailing whitespace can be a hard line break in Markdown.
trim_trailing_whitespace = false

[justfile]
indent_style = tab
